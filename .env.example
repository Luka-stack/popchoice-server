# Copy to .env and adjust. Used by docker compose and by the app when run locally.

# local | staging | production  (production hides /docs)
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173"]

# POSTGRES_HOST is overridden to "db" inside docker compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=popchoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=popchoice
POSTGRES_HOST_PORT=5432

API_PORT=8000
