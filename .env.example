# Copy to .env and adjust. Used by docker compose and by the app when run locally.

# local | staging | production  (production hides /docs)
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173"]

# POSTGRES_HOST is overridden to "db" inside docker compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=popchoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=popchoice
POSTGRES_HOST_PORT=5432

OPENAI_API_KEY=your-openai-api-key-here

API_PORT=8000

# average | least_misery | mixed
GROUP_STRATEGY=least_misery
# only used by "mixed"; 0 behaves like "average", higher punishes uneven enjoyment more
GROUP_MIXED_PENALTY=0.5
# how many top-scored movies are sent to the LLM to choose from
GROUP_CANDIDATE_COUNT=8